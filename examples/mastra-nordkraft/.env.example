# Nordkraft controller, reached over WireGuard (no key: your WG IP is the auth)
NORDKRAFT_API=http://172.20.0.254:8001/api
# Logical sandbox id: the provider finds (label mastra.sandbox=<id>) or deploys it
NORDKRAFT_CONTAINER=sandbox-1
# Mistral inference — https://console.mistral.ai
MISTRAL_API_KEY=
