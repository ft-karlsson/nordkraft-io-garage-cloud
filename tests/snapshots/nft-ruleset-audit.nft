#!/usr/sbin/nft -f
# Generated by container-api (PeerReconciler) from the database.
# Do not edit: the forward and nordkraft_input chains are rewritten
# on every reconcile. See setup/CHILD_PEERS.md.
# 2 owner(s), 2 child peer(s), deny mode: audit (log only)

table inet filter {
	chain forward {
		type filter hook forward priority filter; policy accept;
	}
	chain nordkraft_input {
		type filter hook input priority -10; policy accept;
	}
}
flush chain inet filter forward
flush chain inet filter nordkraft_input

table inet filter {
	chain forward {
		ct state established,related accept
		# owners: 172.20.0.<slot> -> the tenant's container subnet
		iifname "wg0" ip saddr 172.20.0.5 ip daddr 172.21.5.0/24 accept comment "tenant-5"
		iifname "wg0" ip saddr 172.20.0.12 ip daddr 172.21.12.0/24 accept comment "tenant-12"
		# child peers: 172.20.<slot>.<index> -> owner's containers in scope
		iifname "wg0" ip saddr 172.20.5.2 ip daddr 172.21.5.0/24 accept comment "peer-5-2 anna_s laptop all"
		iifname "wg0" ip saddr 172.20.5.3 ip daddr 172.21.5.20 accept comment "peer-5-3 ci-runner db"
		# peer-5-3 ci-runner evil: 172.21.12.2 is outside 172.21.5.0/24, refused
		# peer-5-3 ci-runner gone: no running container with that name (dangling)
		iifname "wg0" ip saddr 172.20.5.3 ip daddr 172.21.5.17 tcp dport { 80, 443 } accept comment "peer-5-3 ci-runner web"
		# anything else arriving from the VPN
		iifname "wg0" counter log prefix "nk-vpn-deny " comment "vpn-default-deny-audit"
	}
	chain nordkraft_input {
		# child peers never reach the controller host itself (API, SSH, NATS)
		iifname "wg0" ip saddr 172.20.1.0-172.20.255.255 counter drop comment "children-never-reach-host"
	}
}
