ROCKET_DATABASES={garage_cloud={url="postgresql://garage_user@localhost:5432/garage_cloud"}}
DEV_MODE=true
NATS_ENABLED=true
NATS_URL=nats://127.0.0.1:4222
GARAGE_ID=ry
GARAGE_LOCATION="Ry, Denmark"
VPN_ENDPOINT=ry.example.dk:51820

# ===== Custom domains (BYO domain) — see setup/CUSTOM_DOMAINS.md =====
# Requires INGRESS_ENABLED=true and the pfSense/HAProxy setup.
#CUSTOM_DOMAINS_ENABLED=true
#ACME_CONTACT_EMAIL=you@example.dk
#ACME_STAGING=false
# Bind address of the dedicated ACME challenge listener (second socket in the
# same process, one route only). Use the controller's LAN IP so pfSense
# reaches it directly; the main API keeps its WireGuard-only BIND_ADDRESS.
#CUSTOM_DOMAINS_CHALLENGE_ADDR=10.0.0.200:8801
#CUSTOM_DOMAINS_MAX_PER_USER=5
#CUSTOM_DOMAINS_RECONCILE_INTERVAL=60
#CUSTOM_DOMAINS_GRACE_DAYS=7
#CUSTOM_DOMAINS_RENEW_BEFORE_DAYS=30
#CUSTOM_DOMAINS_RECHECK_SECONDS=86400
